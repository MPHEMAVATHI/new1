# Copy this file to .env and adjust as needed.
# The application reads paths primarily from configs/config.yaml; these
# environment variables are optional overrides.

# Override the project config file location.
# LUNG_AI_CONFIG_PATH=configs/config.yaml

# Force CPU even if a CUDA GPU is available (useful for reproducible CI runs).
# LUNG_AI_FORCE_CPU=false

# Streamlit server settings (optional).
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true

# Optional: alternate URL to fetch pretrained detection weights from.
# MODEL_ZOO_WEIGHTS_URL=
